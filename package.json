{
  "name": "manifest-generator",
  "version": "1.0.0",
  "description": "A dynamic Web App Manifest generator",
  "keywords": [
    "manifest",
    "webmanifest",
    "generator"
  ],
  "license": "MIT",
  "author": "Antonin1106",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "prettier:write": "npx prettier . --write",
    "prettier:check": "npx prettier . --check",
    "prepare": "husky",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@json-types/web-manifest": "^0.3.0"
  },
  "lint-staged": {
    "**/*": [
      "npm run lint:fix",
      "npm run prettier:write"
    ]
  }
}
